{
  "name": "tiny-civilization",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.ts\"",
    "test:liveness": "LIVENESS_SEEDS=100 LIVENESS_TICKS=5000 node --test test/liveness.test.ts",
    "sweep": "node scripts/sweep.ts",
    "run": "node scripts/run.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "description": "A civilization that lives in a browser tab and only runs while you are looking at it."
}
